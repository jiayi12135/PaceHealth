# Copy this file to backend/.env and fill in real values. Never commit .env.

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Use the *secret* service-role key here, never the anon/public key — this
# backend uses it to bypass RLS on behalf of authenticated users. Never expose
# this key to Flutter.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Used by backend/app/services/ai/ (Stephanie's AI service, vendored into this
# backend) to call the Claude API for plan generation, chat, reports, and
# equipment/ingredient photo recognition.
ANTHROPIC_API_KEY=

# Supabase Storage bucket that equipment/ingredient photos are uploaded to
# before their public URL is handed to Claude's vision API. Must already exist
# as a *public* bucket in the Supabase dashboard (Storage -> New bucket).
# Optional — defaults to "scans" if unset.
SCAN_STORAGE_BUCKET=scans

# Used by app/services/exercise_image_service.py to attach a thumbnail photo to
# each exercise in a generated plan (Plan screen). Free — get a key instantly
# at pexels.com/api, no approval wait. Optional: if unset, exercises just show
# a fallback icon instead of a photo, nothing breaks.
PEXELS_API_KEY=
